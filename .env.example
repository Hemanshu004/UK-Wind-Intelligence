# ---------------------------------------------------------------------------
# Backend Runtime Configuration (Private / Server-Side Only)
# ---------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=https://uk-wind-intelligence.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Official Elexon BMRS Insights Solution API Configuration
# Modern Insights Solution REST endpoints (data.elexon.co.uk) are public.
# API key is supported for backwards-compatibility or high-throughput quotas.
ELEXON_API_KEY=

# ---------------------------------------------------------------------------
# Frontend Build-Time Configuration (Public / Browser Bundle)
# WARNING: All VITE_* variables are bundled into client code; NEVER place secrets here.
# ---------------------------------------------------------------------------
# Leave empty for Docker Compose Nginx reverse proxy, or specify for standalone hosting:
# VITE_API_BASE_URL=http://localhost:8000

